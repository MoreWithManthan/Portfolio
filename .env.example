# Base portfolio requires no API keys. Optional production preview port:
PORT=3000
# Optional Spotify server credentials. Never prefix these with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Static hosts: optional public HTTPS endpoint returning {"track":...}.
# Leave blank for the bundled Node server or an unconnected static site.
NEXT_PUBLIC_SPOTIFY_ENDPOINT=
# When the API runs on a different host, allow only the portfolio origin.
SPOTIFY_ALLOWED_ORIGIN=
